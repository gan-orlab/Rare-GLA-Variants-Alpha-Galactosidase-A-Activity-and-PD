print(skat_result)

skat_result_burden <- SKAT_ChrX(Z, obj.x, kernel = "linear.weighted", r.corr = 1)
print(skat_result_burden)

skat_o_result <- SKAT_ChrX(Z, obj.x, kernel = "linear.weighted", method = "SKATO")
print(skat_o_result)


## Assuming 'set_id' is a vector containing the set IDs corresponding to the variants in 'Z'
skat_o_result <- SKAT_ChrX(Z, obj.x, kernel = "linear.weighted", method = "SKATO", set_id = set_id)


## Initialize a list to store results
results <- list()

## Loop through each set in setid_list
for (set in names(setid_list)) {
  snps_in_set <- setid_list[[set]]
  snp_indices <- match(snps_in_set, colnames(Z))  # Get column indices of SNPs in Z matrix
  snp_indices <- na.omit(snp_indices)  # Remove NA indices
  
  if (length(snp_indices) > 0) {  # Only proceed if there are valid SNP indices
    Z_subset <- Z[, snp_indices, drop = FALSE]
    
    ## Run SKAT
    skat_result <- SKAT_ChrX(Z_subset, obj.x, kernel = "linear.weighted",is_X.inact =FALSE)
    ## Run Burden
    burden_result <- SKAT_ChrX(Z_subset, obj.x, kernel = "linear.weighted", r.corr = 1,is_X.inact =FALSE)
    ## Run SKAT-O
    skat_o_result <- SKAT_ChrX(Z_subset, obj.x, kernel = "linear.weighted", method = "SKATO",is_X.inact =FALSE, )
    
    ## Store results
    results[[set]] <- list(
      SKAT = skat_result$p.value,
      Burden = burden_result$p.value,
      SKAT_O = skat_o_result$p.value
    )
  } else {
    warning(paste("No valid SNP indices found for SETID:", set))
  }
}

## Convert nested list of SKAT results to a data frame
results_df <- do.call(rbind, lapply(names(results), function(set) {
  data.frame(
    SetID = set,
    SKAT = results[[set]]$SKAT,
    Burden = results[[set]]$Burden,
    SKAT_O = results[[set]]$SKAT_O
  )
}))

## Print the results table
print(results)
print(results_df)
