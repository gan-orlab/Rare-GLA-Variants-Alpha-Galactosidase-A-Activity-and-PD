# GWAS
## Set up directories
mkdir plots
mkdir linear
mkdir annos
mkdir sumstats

## Linear regression
### create pheno and sex file first
awk 'BEGIN {OFS="\t"} NR==1 || $9 != "NA" {print $1, $2, $9}' covar_males_Columbia_wPCs.txt > pheno_males_Columbia.txt

awk 'BEGIN {OFS="\t"} NR==1 || $9 != "NA" {print $1, $2, $5}' covar_renamed.txt > sex_males_Columbia.txt

## make bfile have pheno and sex in their fam
plink --bfile Columbia_chrX_males --pheno pheno_males_Columbia.txt --update-sex sex_males_Columbia.txt --make-bed --out Columbia_male_GLA_activity

## Now we do the regression
plink --bfile Columbia_male_GLA_activity --pheno pheno_males_Columbia.txt --covar covar_real_Columbia_males_wPC.txt --covar-name Age,PD,PC1,PC2,PC3,PC4,PC5 --hide-covar --linear --ci 0.95 --maf 0.01 --allow-no-sex --out Columbia_male_GLA_activity

### Issues with NAs output - use --allow-no-sex
