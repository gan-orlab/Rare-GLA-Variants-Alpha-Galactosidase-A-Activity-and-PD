# To compute PCs
## Remove SNPs out of HWE, keep common vars, removes vars with more than 1% missing genotypes
plink --bfile Columbia_chrX_updated --maf 0.01 --geno 0.01 --hwe 5e-6 --make-bed --out filter_better -exclude range ~/runs/go_lab/scripts/exclusion_regions_hg19.txt --threads 20

## do prunning by Slide a window of 1000 SNPs, Shift the window by 10 SNPs each time, Calculate pairwise LD (r²) within
## the window, Remove one SNP from each pair with r² > 0.02 (very strict LD threshold)
plink --bfile filter_better --indep-pairwise 1000 10 0.02 --out pruned_better_and_more --threads 20

## using the pruned list of independent SNPs to make a new bfile
plink --bfile filter_better --extract pruned_better_and_more.prune.in --make-bed --out input_pca --threads 20

## computes the top 20 (or 5, depends) principal components, use autosome-num 23 to recognise X
plink --bfile input_pca --pca 5 --out Columbia_NBA --autosome-num 23

## if having OMP issues use:
export OMP_NUM_THREADS=4

## then compute PCAs with the above code again

## using sed to replace spaces with underscores (_) in the Columbia_NBA.eigenvec file
sed -i 's/ /_/' Columbia_NBA.eigenvec

## If having issues try
### Step 1: Convert to proper space-delimited format
awk '{
    # Reconstruct the line properly
    split($1,a,"_");
    printf "%s %s", a[1], a[2];
    for (i=3; i<=length(a); i++) printf " %s", a[i];
    for (i=2; i<=NF; i++) printf " %s", $i;
    printf "\n";
}' Columbia_NBA.eigenvec > Columbia_NBA.eigenvec.fixed

### Step 2: Add headers
sed -i '1i FID IID PC1 PC2 PC3 PC4 PC5' Columbia_NBA.eigenvec.fixed

### Fix the splitting of Columbia IDs while keeping PC values intact
awk '{
    if(NR==1) {print; next}
    fid = $1;
    iid = $2 "_" $3;  # Recombine Columbia_XXXX
    printf "%s %s", fid, iid;
    for(i=4;i<=NF;i++) printf " %s", $i;
    printf "\n"
}' Columbia_NBA.eigenvec.fixed > Columbia_NBA.eigenvec.corrected

### Verify
head Columbia_NBA.eigenvec.corrected

### Get the correct tab delimited
awk '{$1=$1}1' OFS="\t" Columbia_NBA.eigenvec.corrected > Columbia_NBA.eigenvec.corrected.tab

